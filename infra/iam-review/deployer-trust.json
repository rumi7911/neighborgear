{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "TrustOnlyNamedOperatorWithMfa",
    "Effect": "Allow",
    "Principal": {"AWS": "arn:aws:iam::${AccountId}:user/NeighborGearOperator"},
    "Action": "sts:AssumeRole",
    "Condition": {"Bool": {"aws:MultiFactorAuthPresent": "true"}}
  }]
}
