{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeOnlyApprovedEuNovaLiteProfile",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": ["arn:aws:bedrock:eu-west-1:${AccountId}:inference-profile/eu.amazon.nova-lite-v1:0"]
    },
    {
      "Sid": "RouteOnlyThroughApprovedProfileToVerifiedEuModels",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:eu-west-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-west-3::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-central-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-north-1::foundation-model/amazon.nova-lite-v1:0"
      ],
      "Condition": {
        "ArnEquals": {
          "bedrock:InferenceProfileArn": "arn:aws:bedrock:eu-west-1:${AccountId}:inference-profile/eu.amazon.nova-lite-v1:0"
        }
      }
    }
  ]
}
