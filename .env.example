# Default is cost-free, explicitly labelled simulation. No external messages.
NEIGHBORGEAR_MODE=simulator
NEIGHBORGEAR_DB=backend/data/neighborgear.sqlite3
NEIGHBORGEAR_CREDITS_VERIFIED=false
AWS_DEFAULT_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
# Optional creation gate. Never put this or AWS credentials in VITE_* variables.
# NEIGHBORGEAR_JUDGE_KEY=enter-a-long-random-private-judge-key
